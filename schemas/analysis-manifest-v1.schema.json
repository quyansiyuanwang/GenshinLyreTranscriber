{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:genshin-lyre-transcriber:schema:analysis-manifest:v1",
  "title": "Analysis Manifest v1",
  "description": "Canonical decoded PCM and multi-resolution waveform cache metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "cache_key", "source", "decode", "waveform", "files"],
  "properties": {
    "format_version": {"const": 1},
    "cache_key": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "decode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_track", "start_us", "end_us", "sample_rate", "channels", "sample_format", "frames", "duration_us"],
      "properties": {
        "audio_track": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "start_us": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safe_time"}]},
        "end_us": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safe_time"}]},
        "sample_rate": {"const": 44100},
        "channels": {"const": 2},
        "sample_format": {"const": "f32le"},
        "frames": {"type": "integer", "minimum": 1},
        "duration_us": {"$ref": "#/$defs/safe_time"}
      }
    },
    "waveform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_format", "base_bucket_count", "levels"],
      "properties": {
        "sample_format": {"const": "s16le-min-max-pairs"},
        "base_bucket_count": {"type": "integer", "minimum": 1},
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/waveform_level"}
        }
      }
    },
    "spectral": {"$ref": "#/$defs/spectral"},
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "safe_time": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "waveform_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples_per_bucket", "bucket_count", "offset_bytes", "size_bytes"],
      "properties": {
        "samples_per_bucket": {"type": "integer", "minimum": 1},
        "bucket_count": {"type": "integer", "minimum": 1},
        "offset_bytes": {"type": "integer", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "kind": {"enum": ["pcm", "waveform", "spectrogram", "features"]},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "spectral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "fft_size", "hop_size", "window", "frames", "bins", "db_floor", "db_ceil", "spectrogram", "features"],
      "properties": {
        "format_version": {"const": 1},
        "fft_size": {"type": "integer", "minimum": 64},
        "hop_size": {"type": "integer", "minimum": 1},
        "window": {"enum": ["hann", "hamming", "blackman"]},
        "frames": {"type": "integer", "minimum": 1},
        "bins": {"type": "integer", "minimum": 2},
        "db_floor": {"type": "number"},
        "db_ceil": {"type": "number"},
        "spectrogram": {"$ref": "#/$defs/spectral_file"},
        "features": {"$ref": "#/$defs/features_file"}
      }
    },
    "spectral_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "features_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes", "columns", "hop_us"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "hop_us": {"type": "integer", "minimum": 1}
      }
    }
  }
}
