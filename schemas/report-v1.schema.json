{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:genshin-lyre-transcriber:schema:report:v1",
  "title": "Transcription Report v1",
  "description": "Version 1 processing report. Artifact paths are relative to the result directory and still require semantic path validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application_version", "engine", "input", "parameters", "counts", "warnings", "artifacts"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "application_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "backend"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "backend": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "model": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "filename", "sha256", "segment_start_us"],
      "properties": {
        "source_type": {"enum": ["audio", "video", "midi"]},
        "filename": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/sha256"},
        "segment_start_us": {"$ref": "#/$defs/safe_time"}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timing": {"enum": ["auto", "preserve", "straight", "triplet"]},
        "transpose": {
          "oneOf": [
            {"const": "auto"},
            {"type": "integer", "minimum": -48, "maximum": 48}
          ]
        },
        "audio_track": {"type": "integer", "minimum": 0},
        "start_us": {"$ref": "#/$defs/safe_time"},
        "end_us": {"$ref": "#/$defs/safe_time"},
        "preview_wav": {"type": "boolean"},
        "mapping_profile": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "selected_track": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 0}
      ]
    },
    "elapsed_ms": {"type": "number", "minimum": 0},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_notes", "output_notes", "dropped_notes", "mapped_keys", "replaced_semitones", "octave_folds", "duplicate_keys", "compatibility_collisions"],
      "properties": {
        "input_notes": {"type": "integer", "minimum": 0},
        "output_notes": {"type": "integer", "minimum": 0},
        "dropped_notes": {"type": "integer", "minimum": 0},
        "mapped_keys": {"type": "integer", "minimum": 0},
        "replaced_semitones": {"type": "integer", "minimum": 0},
        "octave_folds": {"type": "integer", "minimum": 0},
        "duplicate_keys": {"type": "integer", "minimum": 0},
        "compatibility_collisions": {"type": "integer", "minimum": 0}
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64},
          "message": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "relative_path", "sha256", "size_bytes"],
        "properties": {
          "kind": {"enum": ["source_midi", "cleaned_midi", "mapped_midi", "events", "readable_text", "compat_text", "preview_wav", "report"]},
          "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "safe_time": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
