{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:genshin-lyre-transcriber:schema:worker:v1",
  "title": "Transcription Worker JSONL v1",
  "description": "One JSON object per line over worker stdin/stdout. Files are referenced by path and are never embedded in protocol messages.",
  "oneOf": [
    {"$ref": "#/$defs/ready"},
    {"$ref": "#/$defs/start"},
    {"$ref": "#/$defs/cancel"},
    {"$ref": "#/$defs/progress"},
    {"$ref": "#/$defs/warning"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/error"},
    {"$ref": "#/$defs/cancelled"}
  ],
  "$defs": {
    "protocol_version": {"type": "integer", "const": 1},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "safe_time": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transpose": {
      "oneOf": [
        {"const": "auto"},
        {"type": "integer", "minimum": -48, "maximum": 48}
      ]
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "job_id", "type", "payload"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "job_id": {"type": "null"},
        "type": {"const": "ready"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worker_version", "application_version", "model_version"],
          "properties": {
            "worker_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "application_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "model_version": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "job_id", "type", "payload"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "type": {"const": "start"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "input_path", "staging_dir", "options"],
          "properties": {
            "operation": {"enum": ["transcribe", "convert_midi"]},
            "input_path": {"type": "string", "minLength": 1, "maxLength": 4096},
            "staging_dir": {"type": "string", "minLength": 1, "maxLength": 4096},
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "timing": {"enum": ["auto", "preserve", "straight", "triplet"]},
                "bpm": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
                "transpose": {"$ref": "#/$defs/transpose"},
                "audio_track": {"type": "integer", "minimum": 0},
                "start_us": {"$ref": "#/$defs/safe_time"},
                "end_us": {"$ref": "#/$defs/safe_time"},
                "preview_wav": {"type": "boolean"},
                "overwrite": {"type": "boolean"},
                "mapping_profile": {"type": "string", "minLength": 1, "maxLength": 128}
              }
            }
          }
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "job_id", "type", "payload"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "type": {"const": "cancel"},
        "payload": {"type": "object", "additionalProperties": false}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "job_id", "type", "payload"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "type": {"const": "progress"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "fraction"],
          "properties": {
            "stage": {"enum": ["validating", "extracting", "importing", "transcribing", "cleaning", "analyzing", "quantizing", "mapping", "exporting", "completed"]},
            "fraction": {
              "oneOf": [
                {"type": "null"},
                {"type": "number", "minimum": 0, "maximum": 1}
              ]
            }
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "job_id", "type", "payload"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "type": {"const": "warning"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64},
            "message": {"type": "string", "minLength": 1, "maxLength": 2048},
            "details": {"type": "object", "additionalProperties": true}
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "job_id", "type", "payload"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "type": {"const": "result"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output_dir", "report_path", "artifacts"],
          "properties": {
            "output_dir": {"type": "string", "minLength": 1, "maxLength": 4096},
            "report_path": {"type": "string", "minLength": 1, "maxLength": 4096},
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "relative_path", "sha256", "size_bytes"],
                "properties": {
                  "kind": {"enum": ["source_midi", "cleaned_midi", "mapped_midi", "events", "readable_text", "compat_text", "preview_wav", "report"]},
                  "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
                  "sha256": {"$ref": "#/$defs/sha256"},
                  "size_bytes": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "job_id", "type", "payload"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "type": {"const": "error"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64},
            "message": {"type": "string", "minLength": 1, "maxLength": 4096},
            "retryable": {"type": "boolean"}
          }
        }
      }
    },
    "cancelled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "job_id", "type", "payload"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "type": {"const": "cancelled"},
        "payload": {"type": "object", "additionalProperties": false}
      }
    }
  }
}
