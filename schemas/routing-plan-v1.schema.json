{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:genshin-lyre-transcriber:schema:routing-plan:v1",
  "title": "Routing Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "mode", "max_voices", "collision", "routes"],
  "properties": {
    "format_version": {"const": 1},
    "mode": {"enum": ["solo", "melody_chords", "two_voice", "full", "custom"]},
    "max_voices": {"type": "integer", "minimum": 1, "maximum": 21},
    "collision": {"enum": ["priority", "highest_velocity", "first"]},
    "routes": {
      "type": "array",
      "items": {"$ref": "#/$defs/route"}
    }
  },
  "$defs": {
    "safe_time": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "sources", "target", "gain_db", "muted", "solo", "priority", "start_us", "end_us"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "enabled": {"type": "boolean"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["vocals", "drums", "bass", "other"]}
        },
        "target": {"enum": ["melody", "harmony", "bass", "percussion", "ignore"]},
        "gain_db": {"type": "number", "minimum": -24, "maximum": 24},
        "muted": {"type": "boolean"},
        "solo": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "start_us": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safe_time"}]},
        "end_us": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safe_time"}]}
      }
    }
  }
}
