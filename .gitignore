.[t]mp/

# Rust build output
/target/
/crates/*/target/

# Python environments and caches
.venv/
__pycache__/
node_modules/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local build and package output
/build/
/dist/
/artifacts/
*.zip
*.gltproj
*.gltproj.*
crates/glt-gui/dist/
crates/glt-gui/src-tauri/gen/
crates/glt-gui/src-tauri/icons/android/
crates/glt-gui/src-tauri/icons/ios/
crates/glt-gui/src-tauri/icons/Square*.png
crates/glt-gui/src-tauri/icons/StoreLogo.png

# Runtime assets and local user data
/models/
/model-cache/
/media/
/input/
/output/
/cache/

# Raw media is not tracked, except explicitly whitelisted test fixtures.
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.opus
*.mp4
*.mkv
*.mov
*.webm
!tests/fixtures/**/*.wav
!tests/fixtures/**/*.mp3
!tests/fixtures/**/*.flac
!tests/fixtures/**/*.mid

# Model weights and downloaded tools are package resources, not source files.
*.onnx
*.tflite
*.pb

# Local secrets
.env
.env.*
!.env.example
*.pem
*.pfx

# Editors and operating-system metadata
.idea/
.vscode/
Thumbs.db
Desktop.ini
